# Envs do Estus Brain, na raiz do projeto. O docker-compose lê este arquivo
# (copie para .env). O backend rodando fora do compose usa backend/.env.
#
# Marcação: [OBRIGATÓRIA] / [OPCIONAL].

# ── Usuário inicial ────────────────────────────────────────────────────────
# [OBRIGATÓRIAS NO PRIMEIRO BOOT] Se o banco não tem nenhum usuário, estas
# duas criam o dono da instância. Depois do primeiro boot podem sair.
ESTUS_ADMIN_EMAIL=
ESTUS_ADMIN_PASSWORD=

# ── Banco ──────────────────────────────────────────────────────────────────
# [OBRIGATÓRIA] O backend não sobe sem ela. No compose já vem apontada para o
# serviço postgres; em produção use a string do datastore.
DATABASE_URL=postgres://estus:estus@postgres:5432/estus_vault?sslmode=disable

# [OPCIONAL] Porta de escuta do backend. Padrão 8080.
PORT=8080

# ── Frontend ───────────────────────────────────────────────────────────────
# [OBRIGATÓRIA para o frontend] Endereço interno do backend. No compose é o
# nome do serviço; no Cubeship é o nome do app backend.
API_URL=http://backend:8080

# [OPCIONAL] URL pública do frontend. Usada no redirect do OAuth do Google.
FRONTEND_URL=http://localhost:3000

# ── Cofre de senhas ────────────────────────────────────────────────────────
# [OPCIONAL, mas obrigatória para o módulo Senhas] Chave mestra AES-256-GCM.
# Gere com: openssl rand -base64 32
# Perdeu a chave, perdeu as senhas — guarde fora do backup do banco.
VAULT_ENCRYPTION_KEY=

# ── Documentos e estado local ──────────────────────────────────────────────
# [OPCIONAL] Onde os arquivos enviados são gravados, relativo ao diretório de
# trabalho do binário. Em produção, monte um volume nesse caminho.
DOCUMENTS_DIR=data/documents

# [OPCIONAL] Estado local do assistente: token do MCP e scratch dirs.
ASSISTANT_DIR=data/assistant

# ── Assistente / MCP ───────────────────────────────────────────────────────
# [OPCIONAL] Bearer token que apps de IA externos usam no /mcp. Vazio =
# gerado uma vez e salvo em ASSISTANT_DIR/mcp-token.
MCP_TOKEN=

# [OPCIONAL] Fuso do dono: "hoje" e horários são lidos nele. Padrão
# America/Sao_Paulo.
ASSISTANT_TZ=America/Sao_Paulo

# [OPCIONAL] true desliga os motores que rodam na sua assinatura pessoal de
# Claude/ChatGPT. Padrão false.
ASSISTANT_MULTI_USER=false

# ── Telegram ───────────────────────────────────────────────────────────────
# [OPCIONAL] Token do bot. Também pode ser salvo pela tela (cifrado com
# VAULT_ENCRYPTION_KEY); o salvo pela tela tem precedência sobre este.
TELEGRAM_BOT_TOKEN=

# ── Google Calendar ────────────────────────────────────────────────────────
# [OPCIONAIS] Só para sincronizar a Agenda com o Google. Sem isto a Agenda
# funciona 100% local. Ver o passo a passo no README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/google/oauth/callback
